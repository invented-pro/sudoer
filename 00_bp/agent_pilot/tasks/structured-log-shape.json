{
  "id": "structured-log-shape",
  "description": "The JSONL log records the run lifecycle — run_start, provider_call, tool_call, run_end — in order, across two goals (C8).",
  "workspace": { "notes.txt": "alpha\n" },
  "turns": [
    { "goal": "Read notes.txt and answer." },
    { "goal": "Thanks." }
  ],
  "script": {
    "steps": [
      {
        "complete": {
          "text": "Reading.",
          "tool_calls": [
            { "type": "tool_call", "name": "read", "arguments": { "path": "notes.txt" } }
          ]
        }
      },
      { "complete": { "text": "It says alpha." } },
      { "complete": { "text": "You're welcome." } }
    ]
  },
  "expect": {
    "runs": [
      { "status": "complete", "answer": { "contains": "alpha" } },
      { "status": "complete", "answer": { "equals": "You're welcome." } }
    ],
    "logs": [
      { "kind": "run_start" },
      { "kind": "provider_call" },
      { "kind": "tool_call", "tool": "read" },
      { "kind": "provider_call" },
      { "kind": "run_end", "status": "complete" },
      { "kind": "run_start" },
      { "kind": "provider_call" },
      { "kind": "run_end", "status": "complete" }
    ]
  }
}
