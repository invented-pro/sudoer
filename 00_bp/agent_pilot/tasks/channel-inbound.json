{
  "id": "channel-inbound",
  "description": "A permitted channel message becomes a goal, may call schedule, and its answer is delivered back to the channel (C6, C11).",
  "clock": { "now": "2026-10-06T09:00:00Z" },
  "channels": {
    "register": [
      { "id": "telegram", "kind": "telegram", "allow_from": ["42"] }
    ],
    "inbound": [
      { "channel": "telegram", "from": "42", "text": "Remind me to take my medication every morning at 8." }
    ]
  },
  "script": {
    "steps": [
      {
        "complete": {
          "text": "Setting that up.",
          "tool_calls": [
            { "type": "tool_call", "name": "schedule", "arguments": { "when": "+1d", "goal": "Take your morning medication", "repeat": "daily@08:00", "channel": "origin" } }
          ]
        }
      },
      { "complete": { "text": "I will remind you every morning at 8." } }
    ]
  },
  "expect": {
    "runs": [
      { "status": "complete", "answer": { "contains": "every morning" } }
    ],
    "tools": ["schedule"],
    "tasks": { "morning medication": { "status": "pending", "repeat": "daily@08:00" } },
    "channels": [{ "channel": "telegram", "to": "42" }]
  }
}
