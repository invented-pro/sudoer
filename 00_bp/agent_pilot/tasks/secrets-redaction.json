{
  "id": "secrets-redaction",
  "description": "The http tool injects the named secret at execution and the scrubber replaces the echoed value in the observation — the value never reaches transcript, log, or answer (C10).",
  "goal": "Send my entry to the journal with my token.",
  "secrets": { "journal-token": "s3cr3t-tok3n-99" },
  "stubs": [
    { "name": "journal", "response": { "status": 200, "body": "stored by Authorization: Bearer s3cr3t-tok3n-99" } }
  ],
  "script": {
    "steps": [
      {
        "complete": {
          "text": "Sending.",
          "tool_calls": [
            { "type": "tool_call", "name": "http", "arguments": { "method": "POST", "url": "{{stub:journal}}/entry", "body": "my entry", "auth": { "secret": "journal-token" } } }
          ]
        }
      },
      { "complete": { "text": "Sent and stored." } }
    ]
  },
  "expect": {
    "status": "complete",
    "answer": { "contains": "Sent", "notContains": "s3cr3t-tok3n-99" },
    "tools": ["http"],
    "observations": ["«secret:journal-token»"],
    "policy": [{ "event": "secret_used", "tool": "http" }]
  }
}
