{
  "id": "guard-denied",
  "description": "A web_fetch to a host on web.deny_hosts is a network guard denial — the host check runs before any socket opens, so the run stays offline — and blocks the run.",
  "goal": "Fetch http://evil.example/notes and summarize it.",
  "config": {
    "web": {
      "enabled": true,
      "deny_hosts": ["evil.example"]
    }
  },
  "script": {
    "steps": [
      {
        "complete": {
          "text": "Fetching the page.",
          "tool_calls": [
            { "type": "tool_call", "name": "web_fetch", "arguments": { "url": "http://evil.example/notes" } }
          ]
        }
      }
    ]
  },
  "expect": {
    "status": "blocked",
    "tools": ["web_fetch"]
  }
}
