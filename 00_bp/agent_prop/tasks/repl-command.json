{
  "id": "repl-command",
  "description": "A /plan command after a goal prints the current plan from the session.",
  "turns": [
    { "goal": "Read a.txt." },
    { "command": "/plan" }
  ],
  "workspace": { "a.txt": "x" },
  "script": {
    "steps": [
      {
        "complete": {
          "text": "planning",
          "plan": [
            { "text": "read a.txt", "done": false }
          ],
          "tool_calls": [
            { "type": "tool_call", "name": "read", "arguments": { "path": "a.txt" } }
          ]
        }
      },
      {
        "complete": {
          "text": "done",
          "plan": [
            { "text": "read a.txt", "done": true }
          ]
        }
      }
    ]
  },
  "expect": {
    "plan": ["read a.txt"],
    "stdoutContains": "- [x] read a.txt"
  }
}
