{
  "provider": {
    "kind": "openai-compatible",
    "base_url": "https://api.example.com/v1",
    "api_key": "your-api-key-here",
    "model": "your-model-name",
    "context_window": 128000,
    "sampling": {
      "max_tokens": 8192,
      "temperature": 0.7
    }
  },
  "web": {
    "search_url": "https://your-search-endpoint.example.com"
  },
  "session_dir": ".build/sessions"
}
