10_impl/agent_orbit/sudoer-orbit.exe
20_eval/agent_prop/sudoer-prop
20_eval/agent_prop/sudoer-prop.exe
20_eval/agent_pilot/sudoer-pilot
20_eval/agent_pilot/sudoer-pilot.exe
20_eval/agent_orbit/sudoer-orbit
20_eval/agent_orbit/sudoer-orbit.exe

# Release staging (keep the directory, ignore its contents)
90_dist/*
!90_dist/.gitkeep

# Builder runtime state and archived generated/ trees (10_impl/agent_pilot)
